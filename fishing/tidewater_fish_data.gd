## 由 anatomy_id 取解剖 + 贴色；找不到回退到 silverside。
static func get_species(anatomy_id: String) -> Dictionary:
	if SPECIES.has(anatomy_id):
		return SPECIES[anatomy_id]
	return SPECIES["silverside"]

static func get_skin(anatomy_id: String) -> Dictionary:
	if SKIN.has(anatomy_id):
		return SKIN[anatomy_id]
	return SKIN["silverside"]
